# Import image. Built outside the air gap, carried in (SPEC 8.1).
# Same base as the pipeline image (Wolfi, pinned by digest - see the header of
# Dockerfile.pipeline for why it moved off bookworm); only PyYAML on top -
# `csv` is in the standard library and SPEC 3 removed the xlsx import, so no
# openpyxl. Every package is pinned to an exact version; never `apk upgrade`.
ARG WOLFI_BASE=cgr.dev/chainguard/wolfi-base@sha256:238642d42c5613936474d00b900c4e65fb6f637d8991c913403ff09a09cf43a3
FROM ${WOLFI_BASE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Europe/Berlin \
    LANG=de_DE.UTF-8 \
    LC_ALL=de_DE.UTF-8

# The source extracts are German: without the locale, umlauts in project
# names and German month names come out wrong, and there is no network at
# runtime to fix it. glibc-2.44-locale-de ships de_DE precompiled and must
# match the base's glibc-2.44. No bash: merge.sh and import.sh run python3
# directly, and ./shell.sh uses the pipeline image.
RUN set -eux; \
    apk add --no-cache \
        python-3.12=3.12.15-r2 \
        tzdata=2026e-r0 \
        glibc-2.44-locale-de=2.44-r8; \
    ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime; \
    echo "$TZ" > /etc/timezone; \
    ln -sf python3.12 /usr/bin/python3; \
    python3 -c "import locale; locale.setlocale(locale.LC_ALL, 'de_DE.UTF-8')"

# pip is a build-time tool, not a runtime dependency (SPEC 8.2: "No pip at
# runtime"): installed for this one step, removed again by the package
# manager that installed it.
COPY docker/requirements.import.txt /tmp/requirements.txt
RUN set -eux; \
    apk add --no-cache py3.12-pip=26.2.1-r2; \
    python3 -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements.txt; \
    rm /tmp/requirements.txt; \
    apk del --no-cache py3.12-pip

# uid 1000 so rootless podman's --userns=keep-id maps the host user cleanly.
RUN addgroup -g 1000 pipeline && adduser -D -u 1000 -G pipeline -s /bin/sh pipeline
USER pipeline
WORKDIR /work
