<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Projekte{% endblock %} - continuum editor</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, -apple-system, sans-serif; margin: 0;
         padding: 1.5rem; max-width: 62rem; }
  h1 { font-size: 1.4rem; }
  legend { font-weight: 600; padding: 0 .4rem; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid #8883; }
  fieldset { border: 1px solid #8884; border-radius: 6px; margin: 1rem 0; padding: .75rem 1rem; }
  label { display: block; font-size: .85rem; opacity: .85; margin-top: .6rem; }
  input[type=text], input[type=number], select {
      width: 100%; box-sizing: border-box; padding: .3rem .4rem; margin-top: .15rem;
      font: inherit;
  }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
         gap: 0 1rem; align-items: start; }
  .group-row { border: 1px dashed #8886; border-radius: 6px; padding: .5rem .75rem;
               margin: .5rem 0; position: relative; }
  .remove-row { position: absolute; top: .4rem; right: .4rem; }
  .finding { padding: .4rem .6rem; border-radius: 4px; margin: .25rem 0; font-size: .85rem; }
  .finding.error { background: #fee; border: 1px solid #f99; }
  .finding.warning { background: #ffe; border: 1px solid #dd9; }
  .finding.saved { background: #efe; border: 1px solid #9d9; }
  .toolbar { margin: 1rem 0; }
  .hint { opacity: .7; font-size: .85rem; }
  a.button, button { display: inline-block; padding: .4rem .9rem; border-radius: 4px;
      border: 1px solid #8886; background: #8881; text-decoration: none; color: inherit;
      cursor: pointer; font: inherit; }
  code { background: #8882; padding: .05rem .3rem; border-radius: 3px; }
</style>
</head>
<body>
<p><a href="/">&larr; Projekte / Projects</a></p>
{% block content %}{% endblock %}
<script>
  const rowCounters = {};
  function addRow(domId) {
    const tpl = document.getElementById('tpl-' + domId);
    const container = document.getElementById('rows-' + domId);
    if (!(domId in rowCounters)) rowCounters[domId] = container.children.length;
    const idx = rowCounters[domId]++;
    const html = tpl.innerHTML.split('__IDX__').join(idx);
    const wrap = document.createElement('div');
    wrap.innerHTML = html;
    container.appendChild(wrap.firstElementChild);
  }
</script>
</body>
</html>
