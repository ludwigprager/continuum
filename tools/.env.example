# Credentials for tools/push-ghcr.sh. Copy this file to .env, fill it in and
# keep it readable by its owner only - it holds a live token:
#
#     cp tools/.env.example tools/.env && chmod 600 tools/.env
#
# The script reads whatever is here and asks at the terminal only for what is
# missing, the token without echo. Values may be quoted; quotes are stripped.

# The GitHub account that logs in to ghcr.io. It is also the default for the
# ghcr.io owner the script still asks for.
GITHUB_USERNAME=

# A personal access token with write:packages (classic) or "Packages: read
# and write" (fine-grained). https://github.com/settings/tokens
GITHUB_TOKEN=
